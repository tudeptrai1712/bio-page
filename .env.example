# Server Configuration
PORT=3000
NODE_ENV=production

# Storage Directory for SQLite Database & Uploads
DATA_DIR=/app/data

# Initial Admin Credentials (used on first initialization)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Security Key for Sessions/JWT
JWT_SECRET=change-this-to-a-secure-random-secret-key

# Redis In-Memory Database & Cache
REDIS_URL=redis://redis:6379

# WebAuthn / Passkey Biometrics Configuration
RP_NAME=Bio Page Passkey
RP_ID=localhost
ORIGIN=http://localhost:3000
